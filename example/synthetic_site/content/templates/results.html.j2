<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Search — {{ site_name }}</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <header>
    <a href="/" id="home-link">{{ site_name }}</a>
    <form id="search-form" action="/search" method="get">
      <input type="text" id="search-input" name="q" value="{{ query }}">
      <button type="submit" id="search-submit">Search</button>
    </form>
  </header>
  <main>
    <ul id="result-list">
      {% for hit in s_main %}
      <li class="result-item" data-thread-id="{{ hit.id }}">
        <a class="result-link" href="/thread/{{ hit.id }}">{{ hit.title }}</a>
      </li>
      {% endfor %}
    </ul>
    <p id="result-count">{{ s_main | length }}</p>
  </main>
</body>
</html>
