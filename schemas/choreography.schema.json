{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airgapped-web-env/schemas/choreography.schema.json",
  "title": "Eval choreography (synthetic-population-spec §4.4)",
  "description": "Dev-signed, ships with the eval definition. A schedule keyed to the episode step, naming individual users and explicit pool rows. Same action enum as the ambient layer; same no-free-text rule.",

  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
    "site_id": { "type": "string", "pattern": "^site-[0-9]{6}$" },
    "choreography_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,126}$" },
    "user_ref": { "type": "string", "pattern": "^u_[0-9]{8}$" },
    "blob_ref": { "type": "string", "pattern": "^content/[0-9a-f]{64}\\.blob$" },
    "action": { "enum": ["form_submit", "vote", "edit_own", "delete_own"] },
    "script_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_step", "action", "form", "route", "content_pool", "pool_row"],
      "properties": {
        "at_step": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "action": { "$ref": "#/$defs/action" },
        "form": { "$ref": "#/$defs/id" },
        "route": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "content_pool": { "$ref": "#/$defs/id" },
        "pool_row": { "type": "integer", "minimum": 0, "maximum": 100000000 }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "user_ref", "script"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "user_ref": { "$ref": "#/$defs/user_ref" },
        "script": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/script_step" } }
      }
    },
    "content_pool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "blob_ref", "row_count"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "blob_ref": { "$ref": "#/$defs/blob_ref" },
        "row_count": { "type": "integer", "minimum": 1, "maximum": 100000000 }
      }
    }
  },

  "type": "object",
  "additionalProperties": false,
  "required": ["choreography_id", "site_id", "question_id", "actors", "ambient", "content_pools"],
  "properties": {
    "choreography_id": { "$ref": "#/$defs/choreography_id" },
    "site_id": { "$ref": "#/$defs/site_id" },
    "question_id": { "$ref": "#/$defs/id" },
    "actors": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/actor" } },
    "ambient": { "enum": ["suppress_for_actors", "suppress_all", "allow"] },
    "content_pools": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/content_pool" } }
  }
}
