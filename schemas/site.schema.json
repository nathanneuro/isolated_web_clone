{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airgapped-web-env/schemas/site.schema.json",
  "title": "Site spec (bundle-format-spec §6)",
  "description": "Plaintext structure describing what to build, never what it contains. No free-text fields exist by construction: every string is an identifier, an enum, a path, or a blob handle.",

  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
    "site_id": { "type": "string", "pattern": "^site-[0-9]{6}$" },
    "hostname": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,61}\\.internal$" },
    "blob_ref": { "type": "string", "pattern": "^(content|index)/[0-9a-f]{64}\\.(blob|shard)$" },
    "route_path": { "type": "string", "pattern": "^/[A-Za-z0-9_\\-./{}]{0,127}$" },
    "asset_path": { "type": "string", "pattern": "^/static/[A-Za-z0-9_\\-./]{1,127}$" },
    "column_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
    "table_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
    "param_ref": { "type": "string", "pattern": "^\\{[a-z][a-z0-9_]{0,62}\\}$" },
    "order_by": {
      "description": "column name plus direction; not free text",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62} (asc|desc)$"
    },
    "column_ref": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}\\.[a-z][a-z0-9_]{0,62}$" }
  },

  "type": "object",
  "additionalProperties": false,
  "required": ["site_id", "tier", "framework", "hostname", "routes", "interactions"],
  "properties": {
    "site_id": { "$ref": "#/$defs/site_id" },
    "tier": { "enum": ["A", "B"] },
    "framework": { "enum": ["fastapi-sqlite-v1", "static-v1"] },
    "hostname": { "$ref": "#/$defs/hostname" },

    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "method"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "path": { "$ref": "#/$defs/route_path" },
          "method": { "enum": ["GET", "POST"] },
          "template": { "$ref": "#/$defs/id" },
          "queries": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "search": { "$ref": "#/$defs/id" },
          "form": { "$ref": "#/$defs/id" },
          "mutation": { "$ref": "#/$defs/id" },
          "redirect_to": { "$ref": "#/$defs/id" }
        }
      }
    },

    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "blob_ref", "engine"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "blob_ref": { "$ref": "#/$defs/blob_ref" },
          "engine": { "enum": ["jinja2", "html"] }
        }
      }
    },

    "db": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tables", "seed_blob_ref", "seed_format"],
      "properties": {
        "seed_blob_ref": { "$ref": "#/$defs/blob_ref" },
        "seed_format": { "enum": ["sqlite-dump-v1"] },
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "columns"],
            "properties": {
              "name": { "$ref": "#/$defs/table_name" },
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "type"],
                  "properties": {
                    "name": { "$ref": "#/$defs/column_name" },
                    "type": { "enum": ["integer", "text", "real", "blob", "timestamp", "boolean"] },
                    "pk": { "type": "boolean" },
                    "fk": { "$ref": "#/$defs/column_ref" },
                    "nullable": { "type": "boolean" },
                    "indexed": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "table"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "table": { "$ref": "#/$defs/table_name" },
          "order_by": { "$ref": "#/$defs/order_by" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "where": {
            "description": "column -> route param reference only. Literal values are content and are forbidden here.",
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "$ref": "#/$defs/column_name" },
            "additionalProperties": { "$ref": "#/$defs/param_ref" }
          },
          "join": {
            "type": "object",
            "additionalProperties": false,
            "required": ["table", "on"],
            "properties": {
              "table": { "$ref": "#/$defs/table_name" },
              "on": { "$ref": "#/$defs/column_ref" }
            }
          }
        }
      }
    },

    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fields"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": { "$ref": "#/$defs/column_name" },
                "type": { "enum": ["text", "textarea", "number", "checkbox", "select", "hidden"] },
                "required": { "type": "boolean" },
                "options_query": {
                  "description": "select options come from a query, never from inline literals",
                  "$ref": "#/$defs/id"
                },
                "max_length": { "type": "integer", "minimum": 1, "maximum": 65536 }
              }
            }
          }
        }
      }
    },

    "mutations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "table", "op", "from_form"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "table": { "$ref": "#/$defs/table_name" },
          "op": { "enum": ["insert", "update", "delete"] },
          "from_form": { "$ref": "#/$defs/id" },
          "bind": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "$ref": "#/$defs/column_name" },
            "additionalProperties": { "$ref": "#/$defs/param_ref" }
          }
        }
      }
    },

    "search": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "tables", "fields", "shard_refs"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["bm25"] },
          "tables": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/table_name" } },
          "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/column_name" } },
          "shard_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^index/[0-9a-f]{64}\\.shard$" }
          }
        }
      }
    },

    "interactions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auth", "payments", "realtime"],
      "properties": {
        "auth": { "enum": ["none", "mock_session", "dead_end"] },
        "payments": { "enum": ["none", "dead_end"] },
        "realtime": { "enum": ["none", "poll_stub"] }
      }
    },

    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "blob_ref"],
        "properties": {
          "path": { "$ref": "#/$defs/asset_path" },
          "blob_ref": { "$ref": "#/$defs/blob_ref" }
        }
      }
    }
  }
}
