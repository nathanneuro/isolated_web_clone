{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airgapped-web-env/schemas/suite.schema.json",
  "title": "Test suite (bundle-format-spec \u00a77)",
  "description": "Plaintext test structure. Anything a test types into or compares against is a fixture key resolved inside the go-live sandbox, never an inline value.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "test_id": {
      "type": "string",
      "pattern": "^T[0-9]{3,4}$"
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^fx_[a-z0-9_]{1,59}$"
    },
    "blob_ref": {
      "type": "string",
      "pattern": "^content/[0-9a-f]{64}\\.blob$"
    },
    "route_ok": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "route",
        "expect_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/test_id"
        },
        "kind": {
          "const": "route_ok"
        },
        "route": {
          "$ref": "#/$defs/id"
        },
        "expect_status": {
          "enum": [
            200,
            302,
            404
          ]
        },
        "path_params_fixture": {
          "$ref": "#/$defs/fixture_id"
        }
      }
    },
    "links_resolve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "route",
        "min_internal_links"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/test_id"
        },
        "kind": {
          "const": "links_resolve"
        },
        "route": {
          "$ref": "#/$defs/id"
        },
        "min_internal_links": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "path_params_fixture": {
          "$ref": "#/$defs/fixture_id"
        }
      }
    },
    "search_returns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "search",
        "query_fixture",
        "expect_min_results"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/test_id"
        },
        "kind": {
          "const": "search_returns"
        },
        "search": {
          "$ref": "#/$defs/id"
        },
        "query_fixture": {
          "$ref": "#/$defs/fixture_id"
        },
        "expect_min_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "expect_contains_fixture": {
          "$ref": "#/$defs/fixture_id"
        }
      }
    },
    "form_persists": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "form",
        "route",
        "input_fixture",
        "verify_query",
        "expect_row_count_delta"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/test_id"
        },
        "kind": {
          "const": "form_persists"
        },
        "form": {
          "$ref": "#/$defs/id"
        },
        "route": {
          "$ref": "#/$defs/id"
        },
        "path_params_fixture": {
          "$ref": "#/$defs/fixture_id"
        },
        "input_fixture": {
          "$ref": "#/$defs/fixture_id"
        },
        "verify_query": {
          "$ref": "#/$defs/id"
        },
        "expect_row_count_delta": {
          "type": "integer",
          "minimum": -10,
          "maximum": 10
        }
      }
    },
    "render_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "route",
        "reference_fixture",
        "max_distance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/test_id"
        },
        "kind": {
          "const": "render_diff"
        },
        "route": {
          "$ref": "#/$defs/id"
        },
        "reference_fixture": {
          "$ref": "#/$defs/fixture_id"
        },
        "max_distance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "path_params_fixture": {
          "$ref": "#/$defs/fixture_id"
        }
      }
    },
    "no_external_requests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "route"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/test_id"
        },
        "kind": {
          "const": "no_external_requests"
        },
        "route": {
          "$ref": "#/$defs/id"
        },
        "path_params_fixture": {
          "$ref": "#/$defs/fixture_id"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suite_id",
    "runner",
    "fixture_blob_ref",
    "tests"
  ],
  "properties": {
    "suite_id": {
      "type": "string",
      "pattern": "^site-[0-9]{6}-r[0-9]{1,4}-tests$"
    },
    "runner": {
      "enum": [
        "playwright-v1"
      ]
    },
    "fixture_blob_ref": {
      "$ref": "#/$defs/blob_ref"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "description": "Discriminated on `kind` rather than a bare oneOf, so a bad field attributes to the branch the author intended instead of collapsing to an unexplained union failure.",
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "route_ok",
              "links_resolve",
              "search_returns",
              "form_persists",
              "render_diff",
              "no_external_requests"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "route_ok"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "$ref": "#/$defs/route_ok"
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "links_resolve"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "$ref": "#/$defs/links_resolve"
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "search_returns"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "$ref": "#/$defs/search_returns"
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "form_persists"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "$ref": "#/$defs/form_persists"
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "render_diff"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "$ref": "#/$defs/render_diff"
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "no_external_requests"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "$ref": "#/$defs/no_external_requests"
            }
          }
        ]
      }
    }
  }
}
